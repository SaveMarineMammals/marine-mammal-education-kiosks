# If mmap (or another stack) already created the GitHub OIDC provider in this
# account, paste its ARN here to avoid "EntityAlreadyExists":
# github_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
github_oidc_provider_arn = ""

