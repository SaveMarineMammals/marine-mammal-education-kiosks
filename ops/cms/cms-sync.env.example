# Copy to /etc/mmek/cms-sync.env on the CMS host.
# deploy-cms-sync.sh sets root:mmek-runner mode 640 so the Actions runner can read it.
# Never commit real secrets.

# Xibo CMS REST API (OAuth2 client_credentials application)
# Loopback to cms-web (Caddy owns host :80/:443 after enable-cms-tls.sh).
# After Force HTTPS, sync must also reach Caddy by hostname (not https://127.0.0.1):
XIBO_CMS_URL=http://127.0.0.1:8080
# Set by enable-cms-tls.sh / deploy-cms-sync.sh (public CMS hostname, no scheme):
# XIBO_CMS_TLS_HOST=server.kiosks.local.belize.savemarinemammals.com
XIBO_CLIENT_ID=
XIBO_CLIENT_SECRET=

# Large / video masters (optional). Prefer a NAS mount:
#   MEDIA_STORE_URI=file:///mnt/media-store
# Or an S3-compatible URI (requires boto3 in the venv):
#   MEDIA_STORE_URI=s3://exhibits/
MEDIA_STORE_URI=

# Paths used by systemd / deploy script (defaults match deploy-cms-sync.sh)
# MMEK_REPO=/opt/mmek/repo
# MMEK_VENV=/opt/mmek/venv
# MMEK_SYNC_LOCK=/var/lock/mmek-cms-sync.lock
