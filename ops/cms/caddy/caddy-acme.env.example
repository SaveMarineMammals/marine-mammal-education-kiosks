# Copy to /etc/mmek/caddy-acme.env on the CMS host (root:root mode 600).
# Used by the caddy systemd unit for Let's Encrypt DNS-01 (Route 53).
# Prefer values from: terraform -chdir=infra/terraform/environments/production output
# Never commit real secrets.

# IAM user from module acme-route53-iam (scoped to the kiosks.local zone)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Required: hosted zone ID for kiosks.local.belize.savemarinemammals.com
AWS_HOSTED_ZONE_ID=
