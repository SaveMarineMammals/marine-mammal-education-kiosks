# Template / reference only. enable-cms-tls.sh writes /etc/caddy/Caddyfile
# with hosted_zone_id from AWS_HOSTED_ZONE_ID (kiosks.local.belize… zone).
#
# ACME DNS-01 TXT records land in kiosks.local.belize.savemarinemammals.com
# (see infra/terraform/modules/dns-facility). CMS may stay on a private LAN IP.

server.kiosks.local.belize.savemarinemammals.com {
	tls {
		dns route53 {
			# hosted_zone_id injected at install time
		}
	}
	reverse_proxy 127.0.0.1:8080
}
