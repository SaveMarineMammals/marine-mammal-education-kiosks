[Unit]
Description=MMEK admin alert (%i)
Documentation=file:///opt/mmek/repo/ops/runbooks/security-patching.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ALERT_ROLE=cms
EnvironmentFile=-/etc/mmek/alert.env
ExecStart=/usr/local/sbin/mmek-admin-alert %i "systemd OnFailure for %i"
