# Copy to /etc/mmek/alert.env (mode 0600). Never commit real tokens.
# URL from: terraform output -raw alert_lambda_url
# Token: same value as Terraform alert_ingest_token / Lambda ALERT_INGEST_TOKEN

ALERT_LAMBDA_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
ALERT_INGEST_TOKEN=replace-me
ALERT_ROLE=cms
# Optional override (defaults to hostname -f):
# ALERT_HOSTNAME=cms-facility-01
