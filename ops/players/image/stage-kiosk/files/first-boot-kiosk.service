[Unit]
Description=MMEK first-boot kiosk configuration
# hostnamectl needs D-Bus / hostnamed; do not use DefaultDependencies=no.
After=local-fs.target dbus.socket systemd-hostnamed.service
Wants=dbus.socket
Before=mmek-kiosk-display.service arexibo.service
ConditionPathExists=!/var/lib/mmek/first-boot-complete
ConditionPathExists=/boot/firmware/kiosk.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/first-boot-kiosk.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
