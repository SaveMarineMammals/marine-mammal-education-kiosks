[Unit]
Description=Arexibo Xibo player (MMEK kiosk)
After=network-online.target mmek-kiosk-display.service
Wants=network-online.target
Requires=mmek-kiosk-display.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=kiosk
Group=kiosk
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/kiosk/.Xauthority
EnvironmentFile=-/etc/mmek/arexibo.env
WorkingDirectory=/var/lib/arexibo
# Wait until the X socket exists (display unit is up).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 45); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; echo "DISPLAY :0 not ready" >&2; exit 1'
ExecStart=/usr/local/sbin/mmek-arexibo-start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
