# First-boot kiosk identity — copy to the FAT boot volume root (next to
# config.txt) before power-on. On the Pi that path is /boot/firmware/kiosk.conf.
# Generate locally only:
#   python3 ops/players/image/generate_kiosk_config.py ...
# Never pass CMS_KEY or TS_AUTHKEY through GitHub Actions.
#
# Do not commit real CMS_KEY or TS_AUTHKEY values to Git.

HOSTNAME=kiosk-lobby-01
CMS_URL=https://server.kiosks.local.belize.savemarinemammals.com
CMS_KEY=replace-me
# Tagged Tailscale auth key (tag:mmek-player only). See ops/runbooks/facility-tailscale.md
TS_AUTHKEY=tskey-auth-replace-me
DISPLAY_GROUP=lobby
