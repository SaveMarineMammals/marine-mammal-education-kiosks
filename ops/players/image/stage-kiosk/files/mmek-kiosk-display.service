[Unit]
Description=MMEK kiosk X11 session (openbox)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
Group=kiosk
PAMName=login
Environment=HOME=/home/kiosk
WorkingDirectory=/home/kiosk
ExecStart=/usr/bin/xinit /home/kiosk/.xinitrc -- /usr/bin/X :0 vt7 -nolisten tcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
